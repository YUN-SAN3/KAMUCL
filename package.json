{
  "name": "kamucl",
  "productName": "KAMUCL",
  "version": "1.0.7",
  "description": "KAMUCL - 简约美观的一键式 Minecraft 启动器",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "tsx --test tests/all.test.ts",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win portable zip",
    "dist:win": "npm run build && electron-builder --win portable zip",
    "dist:mac": "electron-vite build && electron-builder --mac zip --x64 --arm64",
    "dist:all": "electron-vite build && electron-builder --win portable zip --mac zip --x64 --arm64"
  },
  "build": {
    "appId": "com.kamucl.launcher",
    "productName": "KAMUCL",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": ["out/main/WindowMaterial.exe", "out/main/GameWindowFocus.exe", "out/main/kamucl-bridge.jar"],
    "beforePack": "scripts/portable-build-hook.cjs",
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "KAMUCL-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "KAMUCL-${version}.exe"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon-512.png",
      "identity": null,
      "artifactName": "KAMUCL-${version}-mac.${ext}"
    }
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "asar": "^3.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
