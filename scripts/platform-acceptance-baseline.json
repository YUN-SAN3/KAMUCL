  "functions": [
    {
      "id": "appearance-01",
      "acceptance": "黑紫、黑橙、浅色和自定义主题；对照相同数据、CSS视口、缩放、字体、图标、圆角与内容布局"
    },
    {
      "id": "appearance-02",
      "acceptance": "内置/导入壁纸、透明度和深浅主题清晰可读；系统桌面材质差异单列"
    },
    {
      "id": "appearance-03",
      "acceptance": "配置预览、应用、取消、未应用草稿与主题导入导出往返"
    },
    {
      "id": "appearance-04",
      "acceptance": "内置与导入图片混播、稳定ID、勾选、时长、拖动/键盘排序、停用不删文件、全关底色、实例图优先"
    },
    {
      "id": "appearance-05",
      "acceptance": "完整随机轮次、相邻不重复、原列表顺序不变、隐藏暂停、设置与主题往返持久化"
    },
    {
      "id": "appearance-06",
      "acceptance": "全部路由可用；最小窗口与100/125/150%缩放、菜单与弹窗、失焦、隐藏/恢复、原生窗控语义"
    },
    {
      "id": "appearance-07",
      "acceptance": "勾选、半选、禁用、焦点、键盘Space、异步失败恢复、主题保持一致"
    },
    {
      "id": "appearance-08",
      "acceptance": "真实冷/暖启动碎片、组装、实际就绪门控；减少动态效果保持完整头像并准确说明"
    },
    {
      "id": "skin-01",
      "acceptance": "真实账号档案、上传、披风切换、历史预览/重命名/删除/重用、失败恢复"
    },
    {
      "id": "skin-02",
      "acceptance": "真实帧姿态进展；LOGO闲置不占用，互动结束恢复；暂停为自然站姿"
    },
    {
      "id": "skin-03",
      "acceptance": "固定标题/关闭/底栏；工具栏/预览/色板；未登录可编辑，新建/导入/读当前，Slim与Classic"
    },
    {
      "id": "skin-04",
      "acceptance": "画笔、橡皮、吸色、填充、基础层不透明、外层透明、部位显隐与全部显示"
    },
    {
      "id": "skin-05",
      "acceptance": "左键绘制，中键或Alt左键旋转、滚轮缩放、预设视角/恢复、灯光和扩大预览；旋转不修改文档"
    },
    {
      "id": "skin-06",
      "acceptance": "HEX/RGB/HSV/透明度校验、最近使用、预设/自定义色板、撤销重做"
    },
    {
      "id": "skin-07",
      "acceptance": "PNG导出重读，上传；导航/窗口/退出所有关闭意图，保存冻结、保存取消/失败、Esc继续与焦点恢复"
    },
    {
      "id": "mascot-01",
      "acceptance": "同纹理识别特征、大头短身、最近邻采样48x72画布，人物位于LOGO原位且品牌稳定"
    },
    {
      "id": "mascot-02",
      "acceptance": "约380ms平滑转为正面人物，不拍打不计数；实际模型/纹理/反馈图就绪后才接收"
    },
    {
      "id": "mascot-03",
      "acceptance": "接受点击恰好一次接触/音效/计数，队列最多32，超限忙碌，长按键重复忽略"
    },
    {
      "id": "mascot-04",
      "acceptance": "180ms转身、150ms拍打、75ms掌击接触、约500ms局部手印、队列结束回正，连续拍打实际呈现"
    },
    {
      "id": "mascot-05",
      "acceptance": "静音、音量、削波、接触同步、重启增量持久化、只重置卡慕且保留六人历史"
    },
    {
      "id": "mascot-06",
      "acceptance": "Enter/Space、真实原生焦点、关闭焦点返回、隐藏暂停/恢复、接受动作关闭排空、保存失败重试、渲染/音频资源释放"
    },
    {
      "id": "accounts-01",
      "acceptance": "增加/删除/选择/重启持久化，公开展示字段不泄露凭据"
    },
    {
      "id": "accounts-02",
      "acceptance": "设备码登录、取消、刷新、实际认证/许可证检查与真实游戏启动"
    },
    {
      "id": "accounts-03",
      "acceptance": "来源探测/安全确认、配置、登录、多角色选择、刷新、authlib-injector下载校验与启动"
    },
    {
      "id": "accounts-04",
      "acceptance": "使用系统保护存储，Linux密钥环不可用时会话登录明确提示；旧密文保留、刷新后密文不回退、移除账号清理缓存"
    },
    {
      "id": "install-01",
      "acceptance": "目录/清单、原版、Forge、NeoForge、Fabric、Quilt、兼容性提示、录像模组/收藏/Fabric API选择与安装"
    },
    {
      "id": "install-02",
      "acceptance": "扫描/取消扫描、手动设置、按版本与架构选择、自动获取/校验、损坏修复、运行健康、权限和架构准确提示"
    },
    {
      "id": "install-03",
      "acceptance": "注册/解绑/重命名/默认/活动目录、路径去重、实例名称与图标/专属图、版本删除和安装残留清理"
    },
    {
      "id": "install-04",
      "acceptance": "共享和独立目录规划、迁移不覆盖已有文件、配置保留、中文/空格/§路径"
    },
    {
      "id": "install-05",
      "acceptance": "进度、限速/并发/镜像/代理、暂停/继续/取消、失败重试和哈希、所有下载完成状态一致"
    },
    {
      "id": "game-01",
      "acceptance": "对应平台原生Java/LWJGL，真实画面、进入世界/服务器、Mod加载；架构不可用不能假启动"
    },
    {
      "id": "game-02",
      "acceptance": "内存/JVM、分辨率、全屏/最大化、自动配置和实例覆盖优先级"
    },
    {
      "id": "game-03",
      "acceptance": "真实PID和窗口聚焦、保存/正常关窗、重启/取消、启动器退出游戏保持存活、其他游戏不被结束"
    },
    {
      "id": "game-04",
      "acceptance": "缺Java/缺库/模组故障可诊断，日志导出脱敏，退出记录和恢复一致"
    },
    {
      "id": "import-01",
      "acceptance": "Modrinth/PCL、CurseForge、完整客户端、嵌套整合包优先于夹带存档；损坏清单不降级"
    },
    {
      "id": "import-02",
      "acceptance": "独立目录导入私有独.zip：46模组/4材质/2光影/1存档及配置，MC1.20.1 Forge47.4.23；哈希与存档完整、启动；私有数据不公开"
    },
    {
      "id": "import-03",
      "acceptance": "普通存档/目录/ZIP，模组文件/目录，多入口拖入与顶部导入共用分类"
    },
    {
      "id": "import-04",
      "acceptance": "路径穿越/重复目标/特殊文件名、下载失败、补充文件、取消与事务回滚，不删除旧误导入实例"
    },
    {
      "id": "resources-01",
      "acceptance": "图标、列表/筛选/排序/批量选择、启停、锁定、删除、版本切换、更新、依赖、查重、跨版本迁移"
    },
    {
